NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# API key de resend.com, para mandar cotizaciones por correo a los prospectos.
RESEND_API_KEY=tu-resend-api-key
# Service role key de Supabase (Project Settings > API), solo para invitar
# colaboradores desde el servidor. Nunca exponerla como NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
